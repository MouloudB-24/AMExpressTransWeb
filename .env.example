# ============================================================================
#  Variables d'environnement — AM Express Transport
# ============================================================================
#  Copiez ce fichier en « .env » à la racine du projet, puis renseignez la clé.
#      cp .env.example .env
#
#  Le fichier .env n'est PAS versionné (voir .gitignore).
# ============================================================================

# Clé d'accès du service de formulaire Web3Forms (envoi des e-mails de devis/contact).
# Obtenir une clé gratuite : https://web3forms.com → saisir l'e-mail de réception
# (provisoirement contact@amexpress-transport.fr) → la clé est envoyée par e-mail.
#
# ⚠️ Le préfixe PUBLIC_ est nécessaire : la clé est utilisée côté navigateur.
#    Ce n'est pas un secret (elle ne fait qu'identifier le formulaire), mais on
#    la garde en variable d'environnement pour pouvoir la changer sans toucher au code.
#
# Sur Netlify/Vercel : ajouter cette variable dans les réglages du projet
# (Environment Variables) avec le même nom.
PUBLIC_WEB3FORMS_KEY=CHANGEZ-MOI


# ----------------------------------------------------------------------------
# Notification WhatsApp des nouveaux devis — CallMeBot (gratuit)
# ----------------------------------------------------------------------------
# À chaque devis envoyé, une notification WhatsApp part vers le numéro du gérant.
#
# Comment obtenir la clé (une fois) :
#   1. Ajouter le contact CallMeBot : +34 644 51 95 23
#   2. Depuis le WhatsApp du gérant (07 69 72 54 64), envoyer le message :
#        I allow callmebot to send me messages
#   3. CallMeBot répond avec votre apikey personnelle.
#
# ⚠️ Ces valeurs sont utilisées côté navigateur (préfixe PUBLIC_) : la clé est
#    donc visible dans le code de la page. C'est acceptable en V1 car la clé ne
#    permet QUE d'envoyer un message WhatsApp au numéro du gérant (rien d'autre),
#    et elle est révocable. Pour une confidentialité totale, on pourra déplacer
#    l'appel dans une fonction serverless au Sprint 4 (voir README).

# Numéro qui RECOIT les notifications (format international, sans +, ni espaces).
# Ex. pour 07 69 72 54 64 → 33769725464
PUBLIC_CALLMEBOT_PHONE=CHANGEZ-MOI

# Clé API personnelle reçue de CallMeBot.
PUBLIC_CALLMEBOT_APIKEY=CHANGEZ-MOI
