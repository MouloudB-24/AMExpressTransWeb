---
/**
 * Bandeau de consentement RGPD — discret et non bloquant.
 * Le site ne dépose aucun traceur publicitaire : le bandeau est donc informatif.
 * Le choix est mémorisé dans le localStorage (donnée strictement nécessaire,
 * pas un cookie de tracking) pour ne pas réafficher le bandeau ensuite.
 *
 * 👉 Quand un outil de mesure d'audience sera ajouté (Sprint 4), ne charger ses
 *    scripts qu'APRÈS un clic sur « Accepter ».
 */
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-14 z-[60] mx-auto hidden max-w-content px-4 md:bottom-4"
  role="dialog"
  aria-live="polite"
  aria-label="Information sur les données"
>
  <div class="flex flex-col gap-3 rounded-xl border border-marine-100 bg-white p-4 shadow-lg sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-marine-600">
      Ce site n'utilise que des données strictement nécessaires à son fonctionnement
      (aucun traceur publicitaire).
      <a href="/confidentialite" class="font-semibold text-orange-700 underline">En savoir plus</a>.
    </p>
    <button
      id="cookie-accept"
      type="button"
      class="btn-primary shrink-0 !px-5 !py-2 !text-sm"
    >
      J'ai compris
    </button>
  </div>
</div>

<script>
  const KEY = 'amx-consent';
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  try {
    if (banner && !localStorage.getItem(KEY)) {
      banner.classList.remove('hidden');
    }
  } catch {
    // localStorage indisponible (navigation privée stricte) → on n'affiche rien d'intrusif
  }
  accept?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, '1');
    } catch {
      /* ignore */
    }
    banner?.classList.add('hidden');
  });
</script>
