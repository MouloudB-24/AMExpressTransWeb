---
/**
 * CTA final — dernier appel à l'action avant le pied de page.
 * Objectif n°1 : pousser le visiteur à demander un devis.
 */
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="bg-marine-700" aria-labelledby="titre-cta">
  <div class="container-site py-16 text-center sm:py-20">
    <h2 id="titre-cta" class="!text-white text-3xl font-bold sm:text-4xl">
      Un transport à organiser ?
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-marine-100">
      Demandez votre devis gratuit : réponse sous 24 h, sans engagement.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/devis" class="btn-primary">
        Demander un devis gratuit
        <Icon name="arrow" class="h-5 w-5" />
      </a>
      <a href={site.phoneLink} class="btn-secondary">
        <Icon name="phone" class="h-5 w-5" />
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>
