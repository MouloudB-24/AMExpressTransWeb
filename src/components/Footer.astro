---
/**
 * Pied de page : présentation, liens services, navigation, contact, mentions.
 */
import { site, services } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const legalLinks = [
  { label: 'Mentions légales', href: '/mentions-legales' },
  { label: 'Politique de confidentialité', href: '/confidentialite' },
  { label: 'CGV', href: '/cgv' },
];
---

<footer class="mt-16 bg-marine-700 text-marine-100">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Présentation -->
    <div>
      <p class="text-lg font-extrabold text-white">
        AM <span class="text-orange-400">Express</span> Transport
      </p>
      <p class="mt-3 text-sm leading-relaxed text-marine-200">
        Transport léger de marchandises, livraisons et déménagements à
        {site.ville} et sur toute {site.zone}.
      </p>
    </div>

    <!-- Services -->
    <nav aria-label="Nos services">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Nos services</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={s.href} class="transition hover:text-orange-400">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Liens utiles -->
    <nav aria-label="Liens utiles">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Le site</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/" class="transition hover:text-orange-400">Accueil</a></li>
        <li><a href="/zone" class="transition hover:text-orange-400">Zone d'intervention</a></li>
        <li><a href="/a-propos" class="transition hover:text-orange-400">À propos</a></li>
        <li><a href="/devis" class="transition hover:text-orange-400">Demander un devis</a></li>
      </ul>
    </nav>

    <!-- Contact -->
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Contact</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={site.phoneLink} class="flex items-center gap-2 transition hover:text-orange-400">
            <Icon name="phone" class="h-5 w-5 shrink-0" />
            <span>{site.phoneDisplay}</span>
          </a>
        </li>
        <li>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="flex items-center gap-2 transition hover:text-orange-400">
            <Icon name="whatsapp" class="h-5 w-5 shrink-0" />
            <span>WhatsApp</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="break-all transition hover:text-orange-400">
            {site.email}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Barre du bas : copyright + mentions légales -->
  <div class="border-t border-marine-600">
    <div class="container-site flex flex-col items-center justify-between gap-3 py-5 text-xs text-marine-200 sm:flex-row">
      <p>© {year} {site.name}. Tous droits réservés.</p>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="transition hover:text-orange-400">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
