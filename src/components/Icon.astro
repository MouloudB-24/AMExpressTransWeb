---
/**
 * Petit composant d'icônes (SVG en ligne, aucune dépendance, aucun JS).
 * Usage : <Icon name="bolt" class="h-6 w-6" />
 * Les icônes sont purement décoratives → aria-hidden="true".
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;

// Tracés SVG (style "outline", trait de 1.5). viewBox 0 0 24 24.
const paths: Record<string, string> = {
  bolt: '<path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13l0-8Z"/>',
  box: '<path d="M21 8 12 3 3 8m18 0-9 5m9-5v8l-9 5m0-8L3 8m9 5v8M3 8v8l9 5"/>',
  pallet: '<path d="M3 14h18M3 18h18M5 6h14v4H5zM6 18v3M12 18v3M18 18v3"/>',
  truck: '<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7zM7 18.5A1.5 1.5 0 1 1 7 15.5a1.5 1.5 0 0 1 0 3ZM18 18.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  euro: '<path d="M15 6.5A6 6 0 1 0 15 18M4 10h7M4 14h7"/>',
  flash: '<path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13l0-8Z"/>',
  pin: '<path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  phone: '<path d="M6.6 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2 4.5 1.5v3a2 2 0 0 1-2 2A17 17 0 0 1 4.5 5a2 2 0 0 1 2.1-2Z"/>',
  whatsapp: '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z"/><path d="M8.5 8.5c0 4 3 6.5 6.5 6.5 .8 0 1.3-.6 1.3-1.3l-2-1-.9 1c-1.4-.6-2.5-1.7-3-3l1-.9-1-2c-.7 0-1.9.5-1.9 1.7Z"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
};

const d = paths[name] ?? '';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
/>
