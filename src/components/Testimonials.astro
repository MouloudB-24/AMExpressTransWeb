---
/**
 * Section TÉMOIGNAGES — présente dans le code mais MASQUÉE pour l'instant
 * (pas encore de vrais avis clients à afficher).
 *
 * 👉 Pour l'AFFICHER plus tard : retirez la classe « hidden » de la balise
 *    <section> ci-dessous et remplissez le tableau "testimonials" avec de
 *    vrais avis.
 */
import Icon from './Icon.astro';

// Exemples factices — à remplacer par de vrais témoignages clients.
const testimonials = [
  {
    quote: 'Livraison rapide et soignée, je recommande vivement.',
    author: 'Client exemple',
    role: 'Particulier',
  },
  {
    quote: 'Un partenaire fiable pour nos livraisons quotidiennes.',
    author: 'Entreprise exemple',
    role: 'Professionnel',
  },
  {
    quote: 'Réactif et toujours à l\'heure, un vrai plus pour notre activité.',
    author: 'Client exemple',
    role: 'Professionnel',
  },
];
---

<!-- ⚠️ MASQUÉ : retirer « hidden » pour activer la section -->
<section class="hidden bg-marine-50 py-16 sm:py-20" aria-labelledby="titre-temoignages">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="titre-temoignages" class="text-3xl font-bold sm:text-4xl">
        Ils nous font confiance
      </h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure class="rounded-xl border border-marine-100 bg-white p-6 shadow-sm">
            <div class="flex gap-1 text-orange-500" aria-hidden="true">
              <Icon name="check" class="h-5 w-5" />
            </div>
            <blockquote class="mt-3 text-marine-700">“{t.quote}”</blockquote>
            <figcaption class="mt-4 text-sm font-semibold text-marine-500">
              {t.author} — <span class="font-normal">{t.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
