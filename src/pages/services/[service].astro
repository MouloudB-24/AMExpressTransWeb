---
/**
 * PAGES SEO DES SERVICES (/services/<slug>) — générées automatiquement à partir
 * du tableau `services` de src/data/site.ts (une page par service).
 * Chaque page : fil d'Ariane, H1, texte dédié, CTA devis + meta propres.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
// Les autres services, pour les suggérer en bas de page
const others = services.filter((s) => s.slug !== service.slug);
---

<BaseLayout fullTitle={service.metaTitle} description={service.metaDescription}>
  <PageHeader
    title={service.h1}
    breadcrumb={[
      { label: 'Accueil', href: '/' },
      { label: 'Services', href: '/services' },
      { label: service.title },
    ]}
  />

  <section class="container-site py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-lg leading-relaxed text-marine-600">{service.longText}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/devis" class="btn-primary">{service.ctaLabel}</a>
        <a href="/services" class="btn-outline">Voir tous nos services</a>
      </div>
    </div>

    <!-- Autres services -->
    <div class="mt-16">
      <h2 class="text-center text-2xl font-bold">Nos autres prestations</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {others.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBand ctaLabel={service.ctaLabel} />
</BaseLayout>
